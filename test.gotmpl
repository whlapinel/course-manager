<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ .Site.Title }}</title>
    {{ if .Site.Params.favicon }}
      <link rel="icon" href="{{ .Site.Params.favicon }}" />
    {{ end }}
  </head>
  <body class="font-sans text-gray-800 bg-gray-100 p-6">
    <header class="text-center my-8">
      <h1 class="text-4xl font-bold">{{ .Site.Title }}</h1>
      {{ with .Site.Params.tagline }}
        <p class="text-lg text-gray-600 mt-2">{{ . }}</p>
      {{ end }}
    </header>

    <main class="max-w-2xl mx-auto">{{ .Content }}</main>
    {{ with site.Data.data.homePageData }}
      <p>{{ .user.user.FirstName }}</p>
    {{ end }}
    {{ range .Sections }}
      <h2><a href="{{ .RelPermalink }}">{{ .LinkTitle }}</a></h2>
    {{ end }}
    <footer class="text-center mt-12 text-gray-500">
      &copy; {{ now.Year }} {{ .Site.Title }}. All rights reserved.
    </footer>
  </body>
</html>
