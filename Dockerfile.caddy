# Stage 1: Build Caddy with xcaddy
FROM golang:1.24 AS builder

# Install xcaddy and build Caddy with the digitalocean module
RUN go install github.com/caddyserver/xcaddy/cmd/xcaddy@latest && \
    xcaddy build --with github.com/caddy-dns/digitalocean --output /go/bin/caddy

# Stage 2: Final Image
FROM ubuntu:latest

# Install dependencies
RUN apt update && apt install -y ca-certificates

# ✅ Copy Caddy binary from builder
COPY --from=builder /go/bin/caddy /usr/bin/caddy

# ✅ Copy Caddyfile
COPY ./Caddyfile.dev /etc/caddy/Caddyfile.dev
COPY ./Caddyfile.prod /etc/caddy/Caddyfile.prod

# Expose ports
EXPOSE 80
EXPOSE 443
