package lessonviews

import (
	"gh_static_portfolio/internal/app/components"
	"gh_static_portfolio/internal/core/assessment"
	"strconv"
	"time"
)

templ LessonDetailsComponent(props LessonDetailsPage) {
	@appcomponents.NodeDetailsComponent(props.NodeDetailsPage) {
		@props.Tabs()
	}
}

templ EditAssessmentFormComponent(props EditAssessmentForm) {
	<form id="edit-assessment-form">
		<div class="grid grid-cols-2 gap-1">
			<input type="hidden" class="bg-black" value={ strconv.Itoa(props.Assessment.ID) }/>
			<label for="name">Name</label>
			<input type="text" name="name" id="name" value={ props.Assessment.Name } class="bg-black"/>
			<label for="instructions">Instructions</label>
			<textarea class="bg-black font-mono p-1 w-full" id="instructions" name="instructions">{ props.Assessment.Instructions }</textarea>
			<label for="date-assigned">Assigned</label>
			<input type="date" name="date-assigned" id="date-assigned" value={ props.Assessment.DateAssigned.Format(time.DateOnly) } class="bg-black"/>
			<label for="date-due">Due</label>
			<input type="date" name="date-due" id="date-due" value={ props.Assessment.DateDue.Format(time.DateOnly) } class="bg-black"/>
			<label for="category">Category</label>
			<select name="category" id="category" class="bg-black">
				<option
					value={ string(assessment.Prepare) }
					selected?={ props.Assessment.Category == assessment.Prepare }
				>Prepare</option>
				<option
					value={ string(assessment.Rehearse) }
					selected?={ props.Assessment.Category == assessment.Rehearse }
				>Rehearse</option>
				<option
					value={ string(assessment.Perform) }
					selected?={ props.Assessment.Category == assessment.Perform }
				>Perform</option>
				<option
					value={ string(assessment.Midterm) }
					selected?={ props.Assessment.Category == assessment.Midterm }
				>Midterm</option>
				<option
					value={ string(assessment.Final) }
					selected?={ props.Assessment.Category == assessment.Final }
				>Final</option>
			</select>
			<label for="file">File</label>
			<input id="file" name="file" type="text" class="bg-black" value={ props.Assessment.File }/>
			<fieldset>
				<legend>Status</legend>
				<div>
					<input type="radio" id="active" name="dropped" value="false" checked?={ !props.Assessment.Dropped }/>
					<label for="active">Active</label>
				</div>
				<div>
					<input type="radio" id="dropped" name="dropped" value="true" checked?={ props.Assessment.Dropped }/>
					<label for="dropped">Dropped</label>
				</div>
			</fieldset>
		</div>
		<button hx-get={ props.LessonDetailsURL } hx-target="#page">Cancel</button>
		<button type="submit" hx-post={ props.PostEditAssessmentURL } hx-target="#page">Submit</button>
	</form>
}

templ ObjectiveSelectComponent(props ObjectiveSelect) {
	<select id="objectives-select" name="objective">
		for _, objective := range props.Objectives {
			<option value={ strconv.Itoa(objective.Objective.ID) }>{ objective.Name }</option>
		}
	</select>
}

templ SlidesComponent(data Slides) {
	<div id="slides">
		<div class="flex gap-1">
			@data.EditSlidesButton()
			@data.NewTabLink()
		</div>
		<iframe
			srcdoc={ data.HTML }
			class="h-[40rem] w-full border-solid border-orange-500"
		></iframe>
	</div>
}

templ EditSlidesTemplate(data SlidesEditor) {
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/codemirror.min.css"/>
	<style>
        .CodeMirror {
            height: auto;
            /* Adjusts the editor height dynamically */
        }
    </style>
	<!-- CodeMirror Editor -->
	<textarea
		id={ "slides-editor-text-area" }
		name={ "slides-editor-text-area" }
		class="bg-slate-900 min-w-full min-h-96 font-mono p-2"
		id="editor"
	>
		{ data.Content }
	</textarea>
	<!-- CodeMirror Scripts -->
	<script defer src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/codemirror.min.js"></script>
	<script defer src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/markdown/markdown.min.js"></script>
	<script>

		document.addEventListener("DOMContentLoaded", function () {
			console.log("This runs after the DOM is fully loaded.");
			// Initialize CodeMirror
			const editor = CodeMirror.fromTextArea(document.getElementById("slides-editor-text-area"), {
				lineNumbers: true,   // Display line numbers
				mode: "markdown",      // Set syntax highlighting mode
				theme: "default",    // Set theme (default in this example)
				tabSize: 4           // Number of spaces for a tab
			});
		});
    </script>
	@appcomponents.ButtonContainer() {
		@appcomponents.CancelEditButton()
		<button hx-post={ data.PostEditSlidesURL } hx-target="#slides" hx-include={ "#" + EditSlidesTextAreaID }>
			Submit
		</button>
	}
}
