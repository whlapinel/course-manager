package managertemplates

import (
	"gh_static_portfolio/internal/domain"
	"gh_static_portfolio/internal/util"
	"github.com/labstack/echo/v4"
	"strconv"
	"time"
)

templ LessonDetailsComponent(props LessonDetailsPage, components ...templ.Component) {
	@NodeDetailsComponent(props.NodeDetailsPage) {
		if  props.Lesson().Standards != nil {
			<ul>
				for _, objective := range props.Lesson().Standards {
					<li id="objective">
						{ strconv.Itoa(objective.ParentNum) }.{ strconv.Itoa(objective.Number) } { objective.Name }
						<button hx-delete={ props.DeleteStandardURL(objective.ID) } hx-target="#page">Remove</button>
					</li>
				}
			</ul>
		} else {
			<p>No standard selected</p>
		}
		<details>
			<summary>Choose Standard</summary>
			<ul>
				for _, standard := range props.Standards {
					<details>
						<summary>{ standard.Name }</summary>
						<select name="objective" id={ "objective-select-" + strconv.Itoa(standard.ID) } class="bg-black">
							for _, objective := range standard.Children {
								<option value={ strconv.Itoa(objective.ID) }>
									{ strconv.Itoa(objective.ParentNum) }{ "." }{ strconv.Itoa(objective.Number) }{ " " }{ objective.Name }
								</option>
							}
						</select>
						<button hx-post={ props.PostLessonStandardURL } hx-include={ "#objective-select-" + strconv.Itoa(standard.ID) } hx-target="#page">Add</button>
					</details>
				}
			</ul>
		</details>
		if props.Lesson().Assessments != nil {
			<ul>
				for _, assessment := range props.Lesson().Assessments {
					<li id="assessment">
						<details>
							<summary>
								{ assessment.Name }
							</summary>
							<p>{ DisplayCategory(assessment.Category) }</p>
							<p>Due: { assessment.DateDue.Format(time.DateOnly) }</p>
							<pre>{ assessment.Instructions }</pre>
							if assessment.File != "" {
								<a href={ templ.SafeURL(props.E.Reverse(props.FileRHN, AddParams(props.Params, assessment.File)...)) }>
									File: { assessment.File }
								</a>
								if util.IsMarkdown(assessment.File) {
									@props.ViewMarkdownButton(assessment.File)
								}
							}
						</details>
						<button
							hx-get={ props.E.Reverse(props.GetEditAssessmentRHN, AddParams(props.Params, assessment.ID)...) }
							hx-target="#assessment"
						>
							Edit
						</button>
						<button hx-delete={ props.DeleteAssessmentURL(assessment.ID) } hx-target="#page">Remove</button>
					</li>
				}
			</ul>
		} else {
			<p>No Assessment</p>
		}
		<details>
			<summary>Add Assessment</summary>
			@props.NewAssessmentForm()
		</details>
		<div id={ EditSlidesContainerID.String() } class="flex flex-col min-w-screen">
			@ButtonContainer() {
				@props.EditSlidesButton()
			}
		</div>
		if lesson, ok := props.Node.(*domain.Lesson); ok {
			if lesson.Dates != nil {
				for _, date := range lesson.Dates {
					<ul>
						<li>
							{ date.Format(time.DateOnly) }
						</li>
					</ul>
				}
			}
		}
	}
	<button id="show-slides-btn">Show Slides</button>
	<div id="slides" class="flex justify-center h-0 overflow-hidden">
		<script src="/dist/lesson-details.js"></script>
		if props.Slides != "" {
			@Slides(props.Slides)
		}
	</div>
	<div id="markdown">
		for _, component := range components {
			@component
		}
	</div>
}

templ EditAssessmentFormComponent(props EditAssessmentForm) {
	<form id="edit-assessment-form">
		<div class="grid grid-cols-2 gap-1">
			<input type="hidden" class="bg-black" value={ strconv.Itoa(props.Assessment.ID) }/>
			<label for="name">Name</label>
			<input type="text" name="name" id="name" value={ props.Assessment.Name } class="bg-black"/>
			<label for="instructions">Instructions</label>
			<textarea class="bg-black font-mono p-1 w-full" id="instructions" name="instructions">{ props.Assessment.Instructions }</textarea>
			<label for="date-assigned">Assigned</label>
			<input type="date" name="date-assigned" id="date-assigned" value={ props.Assessment.DateAssigned.Format(time.DateOnly) } class="bg-black"/>
			<label for="date-due">Due</label>
			<input type="date" name="date-due" id="date-due" value={ props.Assessment.DateDue.Format(time.DateOnly) } class="bg-black"/>
			<label for="category">Category</label>
			<select name="category" id="category" class="bg-black">
				<option
					value={ strconv.Itoa(int(domain.Prepare)) }
					selected?={ props.Assessment.Category == domain.Prepare }
				>Prepare</option>
				<option
					value={ strconv.Itoa(int(domain.Rehearse)) }
					selected?={ props.Assessment.Category == domain.Rehearse }
				>Rehearse</option>
				<option
					value={ strconv.Itoa(int(domain.Perform)) }
					selected?={ props.Assessment.Category == domain.Perform }
				>Perform</option>
				<option
					value={ strconv.Itoa(int(domain.Midterm)) }
					selected?={ props.Assessment.Category == domain.Midterm }
				>Midterm</option>
				<option
					value={ strconv.Itoa(int(domain.Final)) }
					selected?={ props.Assessment.Category == domain.Final }
				>Final</option>
			</select>
			<label for="file">File</label>
			<input id="file" name="file" type="text" class="bg-black" value={ props.Assessment.File }/>
			<fieldset>
				<legend>Status</legend>
				<div>
					<input type="radio" id="active" name="dropped" value="false" checked?={ !props.Assessment.Dropped }/>
					<label for="active">Active</label>
				</div>
				<div>
					<input type="radio" id="dropped" name="dropped" value="true" checked?={ props.Assessment.Dropped }/>
					<label for="dropped">Dropped</label>
				</div>
			</fieldset>
		</div>
		<button hx-get={ props.LessonDetailsURL } hx-target="#page">Cancel</button>
		<button type="submit" hx-post={ props.PostEditAssessmentURL } hx-target="#page">Submit</button>
	</form>
}

templ ObjectiveSelectComponent(props ObjectiveSelect) {
	<select id="objectives-select" name="objective">
		for _, objective := range props.Objectives {
			<option value={ strconv.Itoa(objective.ID) }>{ objective.Name }</option>
		}
	</select>
}

templ Slides(htmlContent string) {
	<iframe srcdoc={ htmlContent } class="h-[40rem] w-full border-solid border-orange-500"></iframe>
}

