templ EditSlidesTemplate(params domain.NodePath, contents string, editSlidesPostRouteHandler string, e *echo.Echo) {
	// <textarea
	// 	id={ EditSlidesTextAreaID.String() }
	// 	name={ EditSlidesTextAreaID.String() }
	// 	class="bg-slate-900 min-w-full min-h-96 font-mono"
	// >
	// 	{ contents }
	// </textarea>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/codemirror.min.css"/>
	<style>
        .CodeMirror {
            height: auto;
            /* Adjusts the editor height dynamically */
        }
    </style>
	<!-- CodeMirror Editor -->
	<textarea
		id={ "slides-editor-text-area" }
		name={ "slides-editor-text-area" }
		class="bg-slate-900 min-w-full min-h-96 font-mono p-2"
		id="editor"
	>
		{ contents }
	</textarea>
	<!-- CodeMirror Scripts -->
	<script defer src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/codemirror.min.js"></script>
	<script defer src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/markdown/markdown.min.js"></script>
	<script>

		document.addEventListener("DOMContentLoaded", function () {
			console.log("This runs after the DOM is fully loaded.");
			// Initialize CodeMirror
			const editor = CodeMirror.fromTextArea(document.getElementById("slides-editor-text-area"), {
				lineNumbers: true,   // Display line numbers
				mode: "markdown",      // Set syntax highlighting mode
				theme: "default",    // Set theme (default in this example)
				tabSize: 4           // Number of spaces for a tab
			});
		});
    </script>
	@ButtonContainer() {
		@CancelEditButton()
		<button hx-post={ e.Reverse(editSlidesPostRouteHandler, params.ToSlice()...) } hx-target="#page" hx-include={ string(EditSlidesTextAreaID.Selector()) }>
			Submit
		</button>
	}
}

// delete once new assessment form is working
templ OldAssessmentForm(props LessonDetailsPage) {
	<form id="add-assignment-form">
		<label for="name">Name</label>
		<input id="name" name="name" type="text" class="bg-black"/>
		<label for="date-assigned">Assigned</label>
		<input
			class="bg-black"
			id="date-assigned"
			name="date-assigned"
			type="date"
			if props.Lesson().Dates != nil {
				value={ props.Lesson().Dates[0].Format(time.DateOnly) }
			}
		/>
		<label for="date-due">Due</label>
		<input class="bg-black" id="date-due" name="date-due" type="date"/>
		<label for="category">Category</label>
		<select name="category" class="bg-black">
			<option value={ strconv.Itoa(int(domain.Prepare)) }>Prepare</option>
			<option value={ strconv.Itoa(int(domain.Rehearse)) }>Rehearse</option>
			<option value={ strconv.Itoa(int(domain.Perform)) }>Perform</option>
			<option value={ strconv.Itoa(int(domain.Midterm)) }>Midterm</option>
			<option value={ strconv.Itoa(int(domain.Final)) }>Final</option>
		</select>
		<label for="file">File</label>
		<input id="file" name="file" type="text" class="bg-black"/>
		<label for="instructions">Instructions</label>
		<textarea class="bg-black font-mono p-1 w-full" id="instructions" name="instructions"></textarea>
		<input type="hidden" name="lesson-id" value={ strconv.Itoa(props.Lesson().ID) }/>
		<button hx-post={ props.PostAssessmentURL } hx-target="#page" hx-push-url="true">Submit</button>
	</form>
}
