package managertemplates

import (
	"gh_static_portfolio/internal/util"
	"path/filepath"
)

templ FilesComponent(page FilesPage) {
	@PageLayoutComponent(page)
	<div class="grid grid-cols-2">
		<form hx-post={ page.E.Reverse(page.UploadFileRHN, append(page.Params.ToSlice(), filepath.Join(page.CurrentPath))) } enctype="multipart/form-data">
			<label for="file">Choose a file:</label>
			<input type="file" name="file" id="file"/>
			<button type="submit">Upload</button>
		</form>
		<ul class="flex">
			for _, item := range page.Files {
				<li>
					if !item.IsDir {
						<a href={ templ.SafeURL(page.E.Reverse(page.OpenFileRHN, append(page.Params.ToSlice(), filepath.Join(page.CurrentPath, item.Path))...)) }>{ item.Path }</a>
					} else {
						<button
							hx-get={ page.E.Reverse(page.OpenFileRHN, append(page.Params.ToSlice(), filepath.Join(page.CurrentPath, item.Path))...) }
							hx-target="#page"
							hx-push-url="true"
						>
							{ item.Path }
						</button>
					}
					if util.IsMarkdown(item.Path) {
						@page.ViewMarkdownButton(item)
					}
				</li>
			}
		</ul>
	</div>
	<div id="markdown"></div>
}

templ MarkdownIFrame(data MarkdownDocument) {
	<iframe srcdoc={ data.Content } class="h-[40rem] w-full border-solid border-orange-500"></iframe>
}
