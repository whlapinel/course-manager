package managertemplates

import (
	"gh_static_portfolio/internal/domain"
	"github.com/labstack/echo/v4"
	"strconv"
	"time"
)

templ LessonDetailsComponent(props LessonDetailsPage) {
	@NodeDetailsComponent(props.NodeDetailsPage) {
		if props.Lesson().Standards != nil {
			<ul>
				for _, objective := range props.Lesson().Standards {
					<li id="objective">
						{ strconv.Itoa(objective.ParentNum) }.{ strconv.Itoa(objective.Number) } { objective.Name }
						<button hx-delete={ props.DeleteStandardURL(objective.ID) } hx-target="#page">Remove</button>
					</li>
				}
			</ul>
		} else {
			<p>No standard selected</p>
		}
		<details>
			<summary>Choose Standard</summary>
			<ul>
				for _, standard := range props.Standards {
					<details>
						<summary>{ standard.Name }</summary>
						<select name="objective" id={ "objective-select-" + strconv.Itoa(standard.ID) } class="bg-black">
							for _, objective := range standard.Children {
								<option value={ strconv.Itoa(objective.ID) }>
									{ strconv.Itoa(objective.ParentNum) }{ "." }{ strconv.Itoa(objective.Number) }{ " " }{ objective.Name }
								</option>
							}
						</select>
						<button hx-post={ props.PostLessonStandardURL } hx-include={ "#objective-select-" + strconv.Itoa(standard.ID) } hx-target="#page">Add</button>
					</details>
				}
			</ul>
		</details>
		if props.Lesson().Assessments != nil {
			<ul>
				for _, assessment := range props.Lesson().Assessments {
					<li id="assessment">
						<details>
							<summary>
								{ assessment.Name }
							</summary>
							<p>{ DisplayCategory(assessment.Category) }</p>
							<p>Due: { assessment.DateDue.Format(time.DateOnly) }</p>
							<p>{ assessment.Instructions }</p>
						</details>
						<button hx-delete={ props.DeleteAssessmentURL(assessment.ID) } hx-target="#page">Remove</button>
					</li>
				}
			</ul>
		} else {
			<p>No Assessment</p>
		}
		<details>
			<summary>Add Assessment</summary>
			<form id="add-assignment-form">
				<label for="name">Name</label>
				<input id="name" name="name" type="text" class="bg-black"/>
				<label for="date-assigned">Assigned</label>
				<input class="bg-black" id="date-assigned" name="date-assigned" type="date" value={ props.Lesson().Dates[0].Format(time.DateOnly) }/>
				<label for="date-due">Due</label>
				<input class="bg-black" id="date-due" name="date-due" type="date"/>
				<label for="category">Category</label>
				<select name="category" class="bg-black">
					<option value={ strconv.Itoa(int(domain.Prepare)) }>Prepare</option>
					<option value={ strconv.Itoa(int(domain.Rehearse)) }>Rehearse</option>
					<option value={ strconv.Itoa(int(domain.Perform)) }>Perform</option>
					<option value={ strconv.Itoa(int(domain.Midterm)) }>Midterm</option>
					<option value={ strconv.Itoa(int(domain.Final)) }>Final</option>
				</select>
				<label for="instructions">Instructions</label>
				<textarea class="bg-black" name="instructions"></textarea>
				<input type="hidden" name="lesson-id" value={ strconv.Itoa(props.Lesson().ID) }/>
				<button hx-post={ props.PostAssessmentURL } hx-target="#page" hx-push-url="true">Submit</button>
			</form>
		</details>
		<div id={ EditSlidesContainerID.String() } class="flex flex-col min-w-screen">
			@ButtonContainer() {
				<a
					class="bg-purple-600 rounded p-2 m-1 text-lg hover:bg-purple-500 list-none cursor-pointer"
					href={ templ.SafeURL(props.GithubFilesURL) }
					target="_blank"
				>Files on GitHub</a>
				@props.ViewFilesButton()
				@props.ViewSlidesButton()
				@props.EditSlidesButton()
			}
		</div>
		if lesson, ok := props.Node.(*domain.Lesson); ok {
			for _, date := range lesson.Dates {
				<ul>
					<li>
						{ date.Format(time.DateOnly) }
					</li>
				</ul>
			}
		}
	}
	<div id="slides" class="flex justify-center">
		if props.Slides != "" {
			@Slides(props.Slides)
		}
	</div>
}

templ ObjectiveSelectComponent(props ObjectiveSelect) {
	<select id="objectives-select" name="objective">
		for _, objective := range props.Objectives {
			<option value={ strconv.Itoa(objective.ID) }>{ objective.Name }</option>
		}
	</select>
}

templ Slides(htmlContent string) {
	<iframe srcdoc={ htmlContent } class="h-[40rem] w-full border-solid border-orange-500"></iframe>
}

