package components

templ DescriptionListComponent(el DescriptionList) {
	<div>
		<div class="px-4 sm:px-0">
			<h3 class="text-base/7 font-semibold text-white">{ el.Title }</h3>
			<p class="mt-1 max-w-2xl text-sm/6 text-gray-400">{ el.Subtitle }</p>
		</div>
		<div class="mt-6 border-t border-white/10">
			<dl class="divide-y divide-white/10">
				<div class="px-4 py-6 sm:grid sm:grid-cols-2 sm:gap-4 sm:px-0">
					for _, item := range el.Items {
						<dt class="text-sm/6 font-medium text-white">{ item.Name }</dt>
						<dd
							class="mt-1 text-sm/6 text-gray-400 sm:col-span-1 sm:mt-0"
							id={ item.ID }
						>
							{ item.Value }
						</dd>
					}
				</div>
			</dl>
		</div>
	</div>
}
