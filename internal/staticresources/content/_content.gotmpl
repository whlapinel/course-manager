{{ range site.Data.data }}
  {{ warnf "testing the warning in _content.gotmpl" }}
  {{ $page := dict
    "path" .path
    "kind" .kind
    "type" .type
    "title" .title
    "params" .params
  }}
  {{ $.AddPage $page }}
  <!-- Add slides.html as resources -->
  {{ if eq .type "lesson" }}
    {{ with resources.Get .params.slidesPath }}
      {{ warnf .Content }}
      {{ warnf ".MediaType.String: %s" .MediaType.String }}
      {{ $contentValue := .Content | safeHTML }}
      {{ $content := dict
        "mediaType" .MediaType.String
        "value" .Content
      }}

      {{ $resource := dict
        "path" $page.params.slidesPath
        "content" $content
      }}
      {{ $.AddResource $resource }}
    {{ end }}
  {{ end }}
  {{ if eq .type "files" }}
    {{ warnf "file type condition true" }}
    <!-- Add raw files as resources -->
    {{ range .params.files }}
      {{ $file := . }}
      {{ with resources.Get $file.path }}
        {{ $contentValue := "" }}
        {{ if .Content }}
          {{ $contentValue = .Content }}
        {{ else }}
          {{ $contentValue = . | string }}
        {{ end }}
        {{ $content := dict
          "mediaType" .MediaType.String
          "value" .Content
        }}

        {{ $resource := dict
          "path" $file.path
          "content" $content
        }}
        {{ $.AddResource $resource }}
        {{ warnf "Added resource %s with content length %d, MediaType: %s" $file.path (len $contentValue) .MediaType.String }}
      {{ else }}
        {{ warnf "Could not find resource: %s" $file.path }}
      {{ end }}
    {{ end }}


    <!-- Add markdown files as standalone pages -->
    {{ range .params.filePages }}
      {{ $file := . }}
      {{ with resources.Get .path }}
        {{ warnf "Content is: %s" .Content }}

        {{ warnf "Processing file page: %s with content length %d; content path: %s" $file.path (len .Content) $file.contentPath }}

        {{ $content := dict
          "mediaType" "text/markdown"
          "value" .Content
        }}

        {{ $childPage := dict
          "type" "standalone"
          "title" (path.Base $file.path)
          "path" $file.contentPath
          "kind" "page"
          "content" $content
        }}
        {{ $.AddPage $childPage }}
      {{ else }}
        {{ warnf "Could not find file page resource: %s" $file.path }}
      {{ end }}
    {{ end }}

  {{ end }}
{{ end }}
