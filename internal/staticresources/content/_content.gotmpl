{{ range site.Data.data }}
  {{ $page := dict
    "path" .path
    "url" .url
    "kind" .kind
    "type" .type
    "title" .title
    "params" .params
    "weight" .weight
  }}
  {{ $.AddPage $page }}
  <!-- Add slides.html as resources -->
  {{ if eq .type "lesson" }}
    {{ with resources.Get .params.slidesPath }}
      {{ $contentValue := .Content | safeHTML }}
      {{ $content := dict
        "mediaType" .MediaType.String
        "value" .Content
      }}

      {{ $resource := dict
        "title" "Slides"
        "path" $page.params.slidesPath
        "content" $content
      }}
      {{ $.AddResource $resource }}
    {{ end }}
  {{ end }}

{{ end }}
