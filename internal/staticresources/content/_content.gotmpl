{{ range site.Data.data }}
  {{ $page := dict
    "path" .path
    "url" .url
    "kind" .kind
    "type" .type
    "title" .title
    "params" .params
    "weight" .weight
  }}
  {{ warnf "path: %s kind: %s title: %s weight: %.1f" .path .kind .title .weight }}
  {{ $.AddPage $page }}
  <!-- Add slides.html as resources -->
  {{ if eq .type "lesson" }}
    {{ with resources.Get .params.slidesPath }}
      {{ $contentValue := .Content | safeHTML }}
      {{ $content := dict
        "mediaType" .MediaType.String
        "value" .Content
      }}

      {{ $resource := dict
        "title" "Slides"
        "path" $page.params.slidesPath
        "content" $content
      }}
      {{ $.AddResource $resource }}
    {{ end }}
  {{ end }}
  {{ if eq .type "files" }}
    <!-- Add raw files as resources -->
    {{ range .params.files }}
      {{ $file := . }}
      {{ with resources.Get $file.path }}
        {{ $contentValue := "" }}
        {{ if .Content }}
          {{ $contentValue = .Content }}
        {{ else }}
          {{ $contentValue = . | string }}
        {{ end }}
        {{ $content := dict
          "mediaType" .MediaType.String
          "value" .Content
        }}
        {{ $fileTitle := path.Base $file.path }}
        {{ $resource := dict
          "title" $fileTitle
          "path" $file.path
          "content" $content
        }}
        {{ $.AddResource $resource }}
      {{ else }}
        {{ warnf "Could not find resource: %s" $file.path }}
      {{ end }}
    {{ end }}


    <!-- Add markdown files as standalone pages -->
    {{ range .params.filePages }}
      {{ $file := . }}
      {{ with resources.Get .path }}
        {{ $content := dict
          "mediaType" "text/markdown"
          "value" .Content
        }}

        {{ $childPage := dict
          "type" "standalone"
          "title" (path.Base $file.path)
          "path" $file.contentPath
          "kind" "page"
          "content" $content
        }}
        {{ $.AddPage $childPage }}
      {{ else }}
        {{ warnf "Could not find file page resource: %s" $file.path }}
      {{ end }}
    {{ end }}

  {{ end }}
{{ end }}
