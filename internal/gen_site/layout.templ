package sitegenerator

templ DocLayout(title, contents string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/python/styles/markdown-styles.css"/>
		</head>
		<body class="markdown-body">
			@templ.Raw(contents)
		</body>
	</html>
}
