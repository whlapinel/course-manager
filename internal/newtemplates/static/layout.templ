package templates

templ LayoutComponent(data Layout) {
	<!DOCTYPE html>
	<html class="h-full bg-gray-800">
		@data.Head
		<body
			{ data.Attributes... }
			class="h-full"
		>
			<div class="min-h-full">
				<div class="bg-gray-800 pb-32">
					<nav class="bg-gray-800">
						<div class="mx-auto max-w-7xl sm:px-6 lg:px-8">
							<div class="border-b border-gray-700">
								<div class="flex h-16 items-center justify-between px-4 sm:px-0">
									<div class="flex items-center">
										<a href="/">
											<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="m226-559 78 33q14-28 29-54t33-52l-56-11-84 84Zm142 83 114 113q42-16 90-49t90-75q70-70 109.5-155.5T806-800q-72-5-158 34.5T492-656q-42 42-75 90t-49 90Zm178-65q-23-23-23-56.5t23-56.5q23-23 57-23t57 23q23 23 23 56.5T660-541q-23 23-57 23t-57-23Zm19 321 84-84-11-56q-26 18-52 32.5T532-299l33 79Zm313-653q19 121-23.5 235.5T708-419l20 99q4 20-2 39t-20 33L538-80l-84-197-171-171-197-84 167-168q14-14 33.5-20t39.5-2l99 20q104-104 218-147t235-24ZM157-321q35-35 85.5-35.5T328-322q35 35 34.5 85.5T327-151q-25 25-83.5 43T82-76q14-103 32-161.5t43-83.5Zm57 56q-10 10-20 36.5T180-175q27-4 53.5-13.5T270-208q12-12 13-29t-11-29q-12-12-29-11.5T214-265Z"></path></svg>
										</a>
										<div class="hidden md:block">
											<div class="ml-10 flex items-baseline space-x-4">
												<!-- Current: "bg-gray-900 text-white", Default: "text-gray-300 hover:bg-gray-700 hover:text-white" -->
												<div id="confirmation"></div>
												for _, item := range data.NavItems {
													@item.Component()
												}
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</nav>
				</div>
				<main class="-mt-32">
					<div class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
						<div class="rounded-lg bg-slate-900 px-5 py-6 shadow-sm sm:px-6 text-white" id="page">
							@data.Page
						</div>
					</div>
				</main>
			</div>
		</body>
	</html>
}
