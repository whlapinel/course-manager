				</button>
			</li>
		</ul>
	}
}

// CourseManager site
templ LessonListTemplate(termID, courseID, unitID int, lessons []*domain.Lesson, lessonRouteName string, e *echo.Echo) {
	for _, lesson := range lessons {
		<ul>
			<li>
				<button hx-get={ e.Reverse(lessonRouteName, termID, courseID, unitID, lesson.ID) } hx-target="#page" hx-push-url="true">
					{ lesson.Name }
				</button>
			</li>
		</ul>
	}
}

func AddQueryParam(path, key, value string) string {
	u, err := url.Parse(path)
	if err != nil {
		log.Println(err)
		return ""
	}
	query := u.Query()
	query.Set(key, value)
	u.RawQuery = query.Encode()
	log.Println(u.String())
	return u.String()
}

// CourseManager site
templ LessonDetailsTemplate(params CourseIDParams,
	lesson *domain.Lesson,
	unit *domain.Unit,
	course *domain.Course,
	slidesRouteName, editSlidesRouteHandlerName, editLessonRouteHandlerName string,
	e *echo.Echo) {
	<h1>{ lesson.Name }</h1>
	<button
		hx-get={ AddQueryParam(e.Reverse(editLessonRouteHandlerName, params.ToIntSlice()...), "field", kebabCase(string(EditLessonNameInputID))) }
		hx-target={ string(EditLessonContainerID.Selector()) }
	>Edit</button>
	<div id={ string(EditLessonContainerID) }></div>
	if !(lesson.Image.ID == 0) {
		<p>this lesson has an image, I just need to figure out how to render it</p>
	}
	<div class="flex flex-col">
		<div class="flex">
			<p>{ lesson.Description }</p>
			<button
				hx-get={ AddQueryParam(e.Reverse(editLessonRouteHandlerName, params.ToIntSlice()...), "field", kebabCase(string(EditLessonDescInputID))) }
				hx-target={ string(EditLessonContainerID.Selector()) }
			>Edit</button>
			<div id={ string(EditLessonContainerID) }></div>
		</div>
		<a
			class="bg-purple-600 rounded p-2 m-1 text-lg hover:bg-purple-500 list-none cursor-pointer"
			href={ LessonFilesURL(*lesson, *unit, *course) }
			target="_blank"
		>Files</a>
		<a
			class="bg-purple-600 rounded p-2 m-1 text-lg hover:bg-purple-500 list-none cursor-pointer"
			href={ templ.SafeURL(e.Reverse(slidesRouteName, params.ToIntSlice()...)) }
			target="_blank"
		>View Slides</a>
		<button hx-get={ e.Reverse(editSlidesRouteHandlerName, params.ToIntSlice()...) } hx-target="#editor" hx-swap="outerHTML">
			Edit Slides (Placeholder, doesn't work yet)
		</button>
		<textarea id="editor" hidden></textarea>
		for _, date := range lesson.Dates {
			<ul>
				<li>
					{ date.Format(time.DateOnly) }
				</li>
			</ul>
		}
	</div>
}

const (
	EditLessonContainerID ElementID = "edit-lesson-container"
	EditLessonNameInputID ElementID = "lesson-name"
	EditLessonDescInputID ElementID = "lesson-desc"
)

templ EditLessonNameTemplate(lesson domain.Lesson, params CourseIDParams, postEditLessonRouteHandlerName string, e *echo.Echo) {
	<label for={ string(EditLessonNameInputID) }>Name</label>
	<input
		class="bg-black"
		id={ string(EditLessonNameInputID) }
		name={ string(EditLessonNameInputID) }
		type="text"
		value={ lesson.Name }
	/>
	<button hx-post={ e.Reverse(postEditLessonRouteHandlerName, params.ToIntSlice()...) } hx-include={ string(EditLessonNameInputID.Selector()) }>Submit</button>
}

templ EditLessonDescTemplate(lesson domain.Lesson, params CourseIDParams, postEditLessonRouteHandlerName string, e *echo.Echo) {
	<label for={ string(EditLessonDescInputID) }>Description</label>
	<textarea
		class="bg-black"
		id={ string(EditLessonDescInputID) }
		name={ string(EditLessonDescInputID) }
		type="text"
	>{ lesson.Description }</textarea>
	<button hx-post={ e.Reverse(postEditLessonRouteHandlerName, params.ToIntSlice()...) } hx-include={ string(EditLessonDescInputID.Selector()) }>Submit</button>
}

type ElementID string

func (i ElementID) Selector() ElementID {
	return "#" + i
}

const (
	EditSlidesTextAreaID ElementID = "editor"
)

templ EditSlidesTemplate(params CourseIDParams, contents string, editSlidesPostRouteHandler string, e *echo.Echo) {
	<textarea id="editor" name={ string(EditSlidesTextAreaID) } class="bg-slate-900 min-w-full min-h-96 font-mono">
		{ contents }
	</textarea>
	<button hx-post={ e.Reverse(editSlidesPostRouteHandler, params.ToIntSlice()...) } hx-include={ string(EditSlidesTextAreaID.Selector()) }>
		Submit
	</button>
}
