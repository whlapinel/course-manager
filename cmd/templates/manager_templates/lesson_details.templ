templ EditSlidesTemplate(params CourseIDParams, contents string, editSlidesPostRouteHandler string, e *echo.Echo) {
	<textarea id={ EditSlidesTextAreaID.String() } name={ EditSlidesTextAreaID.String() } class="bg-slate-900 min-w-full min-h-96 font-mono">
		{ contents }
	</textarea>
	@ButtonContainer() {
		@CancelEditButton()
		<button hx-post={ e.Reverse(editSlidesPostRouteHandler, params.ToIntSlice()...) } hx-include={ string(EditSlidesTextAreaID.Selector()) }>
			Submit
		</button>
	}
}
