package managertemplates

import (
	"gh_static_portfolio/cmd/domain"
	"gh_static_portfolio/cmd/templates"
	"github.com/labstack/echo/v4"
	"time"
)

// CourseManager site
templ LessonDetailsTemplate(
	params CourseIDParams,
	lesson *domain.Lesson,
	unit *domain.Unit,
	course *domain.Course,
	slidesRouteName, editSlidesRouteHandlerName, editLessonRouteHandlerName, postEditLessonRouteHandlerName, listUnitLessonsRHN string,
	editor LessonEditor,
	e *echo.Echo) {
	<button hx-get={ e.Reverse(listUnitLessonsRHN, params.ToIntSlice()...) } hx-target={ string(pageElementID.Selector()) } hx-push-url="true">
		Back to Unit Lessons
	</button>
	if !(lesson.Image.ID == 0) {
		<p>this lesson has an image, I just need to figure out how to render it</p>
	}
	<div class="flex flex-col">
		@editor.LessonName(false)
		@editor.LessonDescription(false)
		<a
			class="bg-purple-600 rounded p-2 m-1 text-lg hover:bg-purple-500 list-none cursor-pointer"
			href={ templates.LessonFilesURL(*lesson, *unit, *course) }
			target="_blank"
		>Files</a>
		<div id={ EditSlidesContainerID.String() } class="flex flex-col min-w-full">
			@ButtonContainer() {
				@NewHXButton(HxGet, AfterEnd, e.Reverse(slidesRouteName, params.ToIntSlice()...), "", true, true).Component() {
					View Slides
				}
				@NewHXButton(HxGet, "", e.Reverse(editSlidesRouteHandlerName, params.ToIntSlice()...), EditSlidesContainerID.Selector(), true, false).Component() {
					Edit Slides
				}
			}
		</div>
		for _, date := range lesson.Dates {
			<ul>
				<li>
					{ date.Format(time.DateOnly) }
				</li>
			</ul>
		}
	</div>
}

templ Slides(htmlContent string) {
	<iframe srcdoc={ htmlContent }></iframe>
}

templ DescriptionInput(inputID ElementID, description string) {
	<textarea
		id={ string(inputID) }
		class="bg-black min-w-52 min-h-fit"
		name={ string(inputID) }
	>{ description }</textarea>
}

templ NameInput(inputID ElementID, name string) {
	<input
		class="bg-black"
		id={ string(inputID) }
		name={ string(inputID) }
		type="text"
		value={ name }
	/>
}

templ LessonFieldTemplate(
	lesson domain.Lesson,
	params CourseIDParams,
	editLessonRouteHandlerName, postEditLessonRouteHandlerName string,
	containerID ElementID,
	inputID ElementID,
	e *echo.Echo,
	isEdit bool,
	input templ.Component,
	content string,
) {
	<div id={ string(containerID) } class="flex">
		if isEdit {
			@input
			@CancelEditButton()
			<button
				hx-post={ e.Reverse(postEditLessonRouteHandlerName, params.ToIntSlice()...) }
				hx-target={ string(containerID.Selector()) }
				hx-include={ string(inputID.Selector()) }
			>Submit</button>
		} else {
			<p>{ content }</p>
			@EditLessonFieldButton(AddQueryParam(e.Reverse(
				editLessonRouteHandlerName,
				params.ToIntSlice()...,
			), "field", templates.KebabCase(string(inputID))), inputID, containerID)
		}
	</div>
}

templ EditLessonFieldButton(url string, buttonID ElementID, containerID ElementID) {
	<button
		id={ string(buttonID) }
		hx-get={ url }
		hx-push-url="true"
		hx-swap={ "outerHTML" }
		hx-target={ string(containerID.Selector()) }
	>
		Edit
	</button>
}

templ EditSlidesTemplate(params CourseIDParams, contents string, editSlidesPostRouteHandler string, e *echo.Echo) {
	<textarea id={ EditSlidesTextAreaID.String() } name={ EditSlidesTextAreaID.String() } class="bg-slate-900 min-w-full min-h-96 font-mono">
		{ contents }
	</textarea>
	@ButtonContainer() {
		@CancelEditButton()
		<button hx-post={ e.Reverse(editSlidesPostRouteHandler, params.ToIntSlice()...) } hx-include={ string(EditSlidesTextAreaID.Selector()) }>
			Submit
		</button>
	}
}
