package managertemplates

import (
	"gh_static_portfolio/cmd/domain"
	"github.com/labstack/echo/v4"
)

// CourseManager site
templ UnitsListTemplate(termID, courseID int, listTermCoursesRHN string, units []*domain.Unit, unitRouteName string, e *echo.Echo) {
	<button hx-get={ e.Reverse(listTermCoursesRHN, termID) } hx-target={ string(pageElementID.Selector()) } hx-push-url="true">
		Back to Term Courses
	</button>
	for _, unit := range units {
		<ul>
			<li>
				<button hx-get={ e.Reverse(unitRouteName, termID, courseID, unit.ID) } hx-target="#page" hx-push-url="true">
					{ unit.Name }
				</button>
			</li>
		</ul>
	}
}
